# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=yuvainfraedge

# Required by the server-side signed media-upload endpoint.
# Keep CLOUDINARY_API_SECRET only in local/Vercel server environment variables.
CLOUDINARY_CLOUD_NAME=dswoyink7
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Application URL (for OG images and metadata)
VITE_APP_URL=https://umyinfra.in

# Optional Google Identity Services One Tap client ID (OAuth 2.0 Web application).
# Use the client ID ending in .apps.googleusercontent.com, not the Firebase app ID.
VITE_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Vercel Environment (automatically set by Vercel)
# VERCEL_URL=
# VERCEL_ENV=production

# Optional: Custom domain for OG image generation
# OG_IMAGE_BASE_URL=https://umyinfra.in
